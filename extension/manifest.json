{
  "manifest_version": 3,
  "name": "dsh-human-browser",
  "version": "0.1.2",
  "description": "Drive the Chrome you already use — real CDP Input events, no injected scripts, no enabled domains.",
  "minimum_chrome_version": "116",
  "permissions": [
    "debugger",
    "tabs",
    "alarms",
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "dsh-human-browser",
    "default_popup": "popup.html"
  },
  "key": ""
}
